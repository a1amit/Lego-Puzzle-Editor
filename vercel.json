{
  "devCommand": "npx vite --port $PORT",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[[...route]]" },
    { "source": "/((?!api/|@|src/|node_modules/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[[...route]].ts": {
      "memory": 256,
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/keepalive", "schedule": "0 6 * * *" }
  ]
}
