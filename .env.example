# ============================================
# Client-side (VITE_ prefix = exposed to browser)
# ============================================

# Clerk Authentication (get keys at https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# OpenRouter API Key for Puzzle Assistant Chatbot (DEPRECATED — now proxied server-side)
# Only needed for local dev without API; production uses /api/chat proxy
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================
# Server-side (Vercel serverless functions)
# ============================================

# Clerk (server-side token verification)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/lego-puzzle?retryWrites=true&w=majority

# Upstash Redis (rate limiting + leaderboard cache)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# OpenRouter (server-side — no VITE_ prefix, hidden from client)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
CHAT_MODEL=stepfun/step-3.5-flash:free
CHAT_FALLBACK_MODEL=google/gemma-3-27b-it:free
CHAT_MAX_TOKENS=1000
CHAT_TEMPERATURE=0.7
