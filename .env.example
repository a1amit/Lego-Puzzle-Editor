# ============================================
# Client-side (VITE_ prefix = exposed to browser)
# ============================================

# Clerk Authentication (https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Sentry — optional, error tracking and performance monitoring (https://sentry.io)
VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ============================================
# Server-side (Vercel serverless functions)
# ============================================

# Clerk (server-side token verification)
CLERK_SECRET_KEY=sk_test_...

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/lego-puzzle?retryWrites=true&w=majority

# Upstash Redis — optional, used for rate limiting (https://upstash.com)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Google AI Studio — used for puzzle assistant chatbot (Gemma 4 via Gemini API)
# Get your free API key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=AIza...

# Vercel cron secret — protects /api/cron/* endpoints. Vercel auto-injects this
# as `Authorization: Bearer <value>` on cron-triggered requests when set.
# Generate with: openssl rand -hex 32
CRON_SECRET=
